{
    "name": "infrangible/m2-catalog-product-price-calculation",
    "description": "Groundwork for personal prices: lets other Infrangible modules show alternative prices to individual shoppers on product pages and lists and apply them in the cart.",
    "type": "magento2-module",
    "version": "4.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Pricing"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-product-price-calculation",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.1",
        "infrangible/m2-core": "~5.0.4",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-bundle": "~101.0.0",
        "magento/module-catalog": "~104.0.0",
        "magento/module-checkout": "~100.4.0",
        "magento/module-configurable-product": "~100.4.0",
        "magento/module-customer": "~103.0.0",
        "magento/module-directory": "~100.4.0",
        "magento/module-quote": "~101.2.0",
        "magento/module-sales": "~103.0.0",
        "magento/module-swatches": "~100.4.0",
        "psr/log": "~2.0.0||~3.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductPriceCalculation\\": "src"
        }
    }
}
